# BloodConnect Supabase Environment Configuration Template
# Copy this file to .env and configure all variables. Never commit secrets to version control.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:4028

# Add this exact URL to Supabase Auth > URL Configuration > Redirect URLs:
# http://localhost:4028/auth/callback
