# BloodConnect Environment Configuration Template
# Copy this file to .env and configure all variables. Never commit secrets to version control.

# CRITICAL REQUIRED: Secret key used for signing and verifying JSON Web Tokens.
# Must be a cryptographically secure random string with at least 32 characters.
# The application will refuse to start if this variable is empty or undefined.
JWT_SECRET=

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/bloodconnect

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:4028
